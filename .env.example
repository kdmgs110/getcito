# Docker Compose defaults. New installs use PostgreSQL 18. Existing PostgreSQL
# 16 installs must set POSTGRES_IMAGE_TAG=16-alpine until after a dump/restore.
POSTGRES_IMAGE_TAG=18-alpine
DATABASE_URL=postgres://postgres:postgres@postgres:5432/getcito
DEPLOYMENT_MODE=local
VITE_DEPLOYMENT_MODE=local
BETTER_AUTH_SECRET=replace-with-random-hex

# Optional: password reset emails (Brevo-verified sender required)
BREVO_API_KEY=
AUTH_EMAIL_FROM=
AUTH_EMAIL_FROM_NAME=GetCito
APP_URL=http://localhost:3001
VITE_APP_URL=http://localhost:3001
VITE_APP_TIMEZONE=Asia/Kolkata
VITE_APP_LOCALE=en-IN
DISABLE_TELEMETRY=1

# Select providers as model:provider[:version][:online].
SCRAPE_TARGETS=chatgpt:openai-api
ONBOARDING_LLM_TARGET=chatgpt:openai-api
OPENAI_API_KEY=replace-me
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_BASE_URL=
CLORO_API_KEY=
OLOSTEP_API_KEY=
BRIGHTDATA_API_TOKEN=
OXYLABS_USERNAME=
OXYLABS_PASSWORD=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Optional GA4 read-only traffic analysis. See GA4_SETUP.md.
GOOGLE_ANALYTICS_CLIENT_ID=
GOOGLE_ANALYTICS_CLIENT_SECRET=
GOOGLE_ANALYTICS_REDIRECT_URI=http://localhost:3001/api/analytics/google/callback
# Generate once with: openssl rand -hex 32
ANALYTICS_TOKEN_ENCRYPTION_KEY=
